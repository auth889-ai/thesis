# macOS
.DS_Store
**/.DS_Store

# Old scratch areas (pre-Lab-00)
/paper
test/

# ---- Data / storage policy: large files live in Google Drive, never in git ----
datasets/
**/datasets/raw/
*.csv.part
*.parquet
*.pbf
*.sqlite
*.duckdb

# Model weights / checkpoints
*.pt
*.pth
*.ckpt
*.h5
checkpoints/

# Secrets
.env
*.env
**/secrets*

# Caches / notebook noise
__pycache__/
*.pyc
.ipynb_checkpoints/
**/duckdb_tmp/

# Large experiment outputs (small summary CSVs/PNGs under paper_labs/*/outputs are tracked)
outputs/large/
**/outputs/large/

# Exceptions: small audit CSVs inside lab outputs ARE tracked
!paper_labs/**/outputs/**/*.csv

# Artifact archive zips stay local, never in git
paper_labs/**/outputs/**/*.zip

# stray generated route files at lab root (build artifacts)
paper_labs/*/routes.rou.xml
paper_labs/*/*.trips.xml

# Lab 02 preliminary run artifacts (regenerated by approved v2 execution)
paper_labs/02_dhaka_osm/outputs/lab02_*/
.env

# ---- Integrated build mode: external upstream workspace & large artifacts ----
# Official repos are cloned to $DHAKAFLOW_WORKSPACE (default ~/.dhakaflow/upstream),
# outside the repo. upstream/ here holds manifests only.
/upstream/*/
# Evidence STAYS IN GIT so a reviewer can see the work without running anything:
# figures, metrics, tables, manifests, logs-as-evidence. Only genuinely large
# binaries are excluded (datasets, weights, video, archives) — those live in
# Drive/S3 and are referenced by checksum + URI.
artifacts/**/*.mp4
artifacts/**/*.avi
artifacts/**/*.mov
artifacts/**/*.zip
artifacts/**/*.tar
artifacts/**/*.tar.gz
artifacts/**/*.npz
artifacts/**/*.npy
artifacts/**/*.pkl
artifacts/**/*.parquet
*.onnx
*.safetensors
artifacts/**/*.dat
artifacts/**/*.npy
artifacts/**/*.pkl

# road511 recorder output (grows continuously; never in git)
artifacts/road511_recordings/
artifacts/datasets_staging/
artifacts/react_demo*/
