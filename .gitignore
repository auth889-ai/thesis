# macOS
.DS_Store
**/.DS_Store

# Old scratch areas (pre-Lab-00)
/paper
test/
screens/

# ---- Data / storage policy: large files live in Google Drive, never in git ----
datasets/
**/datasets/raw/
*.csv.part
*.parquet
*.pbf
*.sqlite
*.duckdb

# Model weights / checkpoints
*.pt
*.pth
*.ckpt
*.h5
checkpoints/

# Secrets
.env
*.env
**/secrets*

# Caches / notebook noise
__pycache__/
*.pyc
.ipynb_checkpoints/
**/duckdb_tmp/

# Large experiment outputs (small summary CSVs/PNGs under paper_labs/*/outputs are tracked)
outputs/large/
**/outputs/large/

# Exceptions: small audit CSVs inside lab outputs ARE tracked
!paper_labs/**/outputs/**/*.csv

# Artifact archive zips stay local, never in git
paper_labs/**/outputs/**/*.zip

# stray generated route files at lab root (build artifacts)
paper_labs/*/routes.rou.xml
paper_labs/*/*.trips.xml

# Lab 02 preliminary run artifacts (regenerated by approved v2 execution)
paper_labs/02_dhaka_osm/outputs/lab02_*/
.env

# ---- Integrated build mode: external upstream workspace & large artifacts ----
# Official repos are cloned to $DHAKAFLOW_WORKSPACE (default ~/.dhakaflow/upstream),
# outside the repo. upstream/ here holds manifests only.
/upstream/*/
# Evidence STAYS IN GIT so a reviewer can see the work without running anything:
# figures, metrics, tables, manifests, logs-as-evidence. Only genuinely large
# binaries are excluded (datasets, weights, video, archives) — those live in
# Drive/S3 and are referenced by checksum + URI.
artifacts/**/*.mp4
artifacts/**/*.avi
artifacts/**/*.mov
artifacts/**/*.zip
artifacts/**/*.tar
artifacts/**/*.tar.gz
artifacts/**/*.npz
artifacts/**/*.npy
artifacts/**/*.pkl
artifacts/**/*.parquet
*.onnx
*.safetensors
artifacts/**/*.dat
artifacts/**/*.npy
artifacts/**/*.pkl
artifacts/case_rush_live/case_report.html
artifacts/case_rush_test/case_report.html
artifacts/gates/pneuma_calibration/opt_run.log
artifacts/mosaic_dhaka/dhaka_r1/sumo/dhaka_r1.net.xml
artifacts/site_i70/site.osm
results/final_validation/fcd.xml

# road511 recorder output (grows continuously; never in git)
artifacts/road511_recordings/
artifacts/datasets_staging/
artifacts/react_demo*/
BasicTS_legacy
artifacts/urban_real_site/*.csv

# Phase-1 prediction: data and large artefacts stay out of git (fetched/regenerated, sha-recorded)
data/forecasting/cities/*/
# raw city arrays are fetched from Drive, never committed (35 MB+ each)
data/forecasting/cities/*.npz
data/forecasting/cities/*.h5
data/forecasting/live_dhaka/
results/forecasting/aws_logs/
results/forecasting/checkpoints/
results/routing/**/dua/
data/routing/athens_d8/*.xml

# SUMO/MOSAIC run outputs: regenerated by the commands in results/RESULTS.md, never committed
results/routing/**/tripinfo.xml
results/routing/**/edgedata.xml
results/routing/**/statistic.xml
results/routing/**/*.rou.xml
results/routing/**/trips*.xml
results/routing/scale0.2/
results/routing/model_in_loop/
results/forecasting/aws_logs/

# the frozen Dhaka R1 network is the substrate for every routing experiment: keep the
# compressed copy tracked so a fresh clone can run, ignore the expanded one
!paper_labs/02_dhaka_osm/outputs/lab02_v2/network/dhaka_r1.net.xml.gz

# supervisor package, rebuilt on demand
DhakaFlow_thesis.zip

# derived per-city graphs, rebuildable from the spec
data/cities/

# live twin + chain run outputs: regenerated by `make chain` / the Live Twin page, never committed
results/routing/runs/
results/live/sim/
results/live/observatory.sqlite
results/forecasting/forecast_log.sqlite
results/demo/
results/live/user_datasets/
