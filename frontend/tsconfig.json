{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "baseUrl": ".", "paths": {"@/*": ["src/*"]}, "types": ["vite/client", "vitest/globals", "vite-plugin-pwa/client"]
  },
  "include": ["src"]
}
