  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-constants": "~57.0.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
